---
import Plain from '../../layouts/Plain.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Plain title="Projects" description="Things I've built.">
	<h1>Projects</h1>
	<ul>
		{
			projects.map((project) => (
				<li>
					<h2>
						<a href={`/projects/${project.id}`}>{project.data.title}</a>
					</h2>
					<p>{project.data.summary}</p>
					{project.data.tags.length > 0 && <p class="muted">{project.data.tags.join(' · ')}</p>}
				</li>
			))
		}
	</ul>
</Plain>

<style>
	ul {
		list-style: none;
		padding: 0;
	}

	li {
		padding: 1rem 0;
		border-bottom: 1px solid var(--border);
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
	}

	p {
		margin: 0.25rem 0 0;
	}
</style>
